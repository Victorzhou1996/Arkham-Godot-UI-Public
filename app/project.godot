; Engine configuration file.
config_version=5

[application]
config/name="诡镇奇谈 · 新版"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="ArkhamUI-New"
config/icon="res://icon-eldersign-blue2.png"
config/windows_native_icon="res://icon-eldersign-blue2.ico"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/window_width_override=2000
window/size/window_height_override=1200
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]
project/assembly_name="ArkhamApp"

[importer_defaults]
texture={
"mipmaps/generate": true,
"compress/mode": 1,
"compress/lossy_quality": 0.9
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.035, 0.03, 0.028, 1)
