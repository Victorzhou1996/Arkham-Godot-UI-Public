<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EosProbe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EosSdkDir Condition="'$(EosSdkDir)' == ''">C:\Users\victo\.arkham\eos-sdk-1.19.2.1</EosSdkDir>
  </PropertyGroup>
  <!-- Windows host (default): x64 Windows SDK. macOS host: Mac SDK dylib, EOS_PLATFORM_OSX. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);EOS_PLATFORM_WINDOWS_64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);EOS_PLATFORM_OSX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="P2pProbe.cs" />
    <Compile Include="$(EosSdkDir)\SDK\Source\Core\**\*.cs" />
    <Compile Include="$(EosSdkDir)\SDK\Source\Generated\**\*.cs" Exclude="$(EosSdkDir)\SDK\Source\Generated\Android\**;$(EosSdkDir)\SDK\Source\Generated\IOS\**" />
    <None Condition="!$([MSBuild]::IsOSPlatform('OSX'))" Include="$(EosSdkDir)\SDK\Bin\EOSSDK-Win64-Shipping.dll" Link="EOSSDK-Win64-Shipping.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX'))" Include="$(EosSdkDir)/SDK/Bin/libEOSSDK-Mac-Shipping.dylib" Link="libEOSSDK-Mac-Shipping.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
